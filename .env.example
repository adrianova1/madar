# APP_URL: The public HTTPS URL where MADAR is hosted (e.g. https://madar.yourdomain.com).
APP_URL="https://madar.example.com"

# DATABASE_PATH: Recommended path OUTSIDE the Git/webroot folder in production (e.g. /home/user/madar_data/madar.db).
DATABASE_PATH=""

# TELEGRAM_BOT_TOKEN: Token from @BotFather for Telegram Webhook, Bot API moderation actions, and initData HMAC validation.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: REQUIRED in production. Verified via timing-safe comparison against X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_BOT_USERNAME: Public bot username without @ (e.g. MadarBot).
TELEGRAM_BOT_USERNAME="MadarBot"

# MADAR_ADMIN_PASSCODE: Optional server-side passcode overriding first-run claimed admin password.
MADAR_ADMIN_PASSCODE=""

# SMS_PROVIDER_URL: Real Iranian SMS gateway HTTP endpoint (e.g. Kavenegar / Melipayamak / SMS.ir) for +98 OTP delivery.
SMS_PROVIDER_URL=""

# SMS_PROVIDER_API_KEY: Server-side API key for the configured SMS gateway. Never exposed to the browser.
SMS_PROVIDER_API_KEY=""
