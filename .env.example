# GEMINI_API_KEY: Required for Gemini AI group assistant calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where MADAR is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token from @BotFather for Telegram Webhook & initData HMAC validation.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: Secret token verified via X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_BOT_USERNAME: Public bot username without @ (e.g. MadarBot).
TELEGRAM_BOT_USERNAME="MadarBot"

# MADAR_ADMIN_PASSCODE: Optional server-side passcode overriding first-run claimed admin password.
MADAR_ADMIN_PASSCODE=""

# SMS_PROVIDER_API_KEY: Optional Iranian SMS provider key (e.g. Kavenegar / Melipayamak) for +98 OTP delivery.
SMS_PROVIDER_API_KEY=""
