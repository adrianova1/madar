# APP_URL: Public HTTPS URL where MADAR is hosted (e.g. https://madar.yourdomain.com).
APP_URL="https://madar.example.com"

# DATABASE_PATH: Recommended SQLite path OUTSIDE Git/webroot in production (e.g. /home/user/madar_data/madar.db).
DATABASE_PATH=""

# SESSION_SECRET: REQUIRED in production (min 32 random hex chars) for persistent server-side sessions across restarts.
SESSION_SECRET=""

# TELEGRAM_BOT_TOKEN: Token from @BotFather for Telegram initData HMAC validation, Webhook, Forced Channel check & Contact flow.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: REQUIRED in production. Verified via timing-safe comparison against X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_BOT_USERNAME: Public Telegram bot username without @.
TELEGRAM_BOT_USERNAME="m4d4rbot"

# ADMIN_TELEGRAM_ID: Numeric Telegram User ID of the primary administrator (never hardcoded in source).
ADMIN_TELEGRAM_ID=""

# REQUIRED_TELEGRAM_CHANNELS: Optional fallback JSON array or comma list of forced channels (e.g. @madarchannel).
# Can also be managed dynamically from the hidden /admin panel.
REQUIRED_TELEGRAM_CHANNELS=""
